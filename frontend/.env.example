# API Configuration
# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Site URL (used for sitemap.xml and robots.txt)
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (uncomment and set when deploying):
# NEXT_PUBLIC_SITE_URL=https://reconex-frontend.onrender.com

# Production (uncomment and set when deploying)
# NEXT_PUBLIC_API_URL=https://reconex.onrender.com

# PostHog Product Analytics
# Get your API key from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
# US Cloud (default): https://us.i.posthog.com
# EU Cloud:           https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
