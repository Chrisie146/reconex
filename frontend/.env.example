# API Configuration
# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (set in Railway environment variables - use your Railway backend service URL):
# NEXT_PUBLIC_API_URL=https://reconex-api-production.up.railway.app

# Server-side backend URL used by Next.js rewrites (not exposed to the browser).
# Set this in Railway frontend service variables alongside NEXT_PUBLIC_API_URL.
# BACKEND_URL=https://reconex-api-production.up.railway.app

# PostHog Product Analytics
# Get your API key from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
# US Cloud (default): https://us.i.posthog.com
# EU Cloud:           https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
